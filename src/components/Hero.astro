---
---
<section class="hero" id="top">
  <div class="orbit" aria-hidden="true">
    <div class="grid-bg"></div>
    <svg class="orbit-svg" viewBox="0 0 1250 294" preserveAspectRatio="xMidYMid meet">
      <defs>
        <radialGradient id="planet-grad" cx="32%" cy="28%" r="70%">
          <stop offset="0%" stop-color="#d3ffe2" />
          <stop offset="25%" stop-color="#6cf2a7" />
          <stop offset="55%" stop-color="#00e676" />
          <stop offset="100%" stop-color="#007a36" />
        </radialGradient>
        <radialGradient id="planet-shade" cx="72%" cy="80%" r="65%">
          <stop offset="0%" stop-color="rgba(0,0,0,0.55)" />
          <stop offset="100%" stop-color="rgba(0,0,0,0)" />
        </radialGradient>
      </defs>
      <ellipse cx="625" cy="147" rx="624" ry="146"
        fill="none" stroke="rgba(0,230,118,0.28)" stroke-dasharray="6 6" />
      <g class="orbit-mover">
        <g class="planet-spin">
          <circle r="22" fill="url(#planet-grad)" />
          <ellipse cx="-7" cy="-3" rx="7" ry="3" fill="rgba(0,0,0,0.36)" transform="rotate(-18)" />
          <ellipse cx="6" cy="7" rx="5" ry="2.4" fill="rgba(0,0,0,0.28)" transform="rotate(14)" />
          <circle r="22" fill="url(#planet-shade)" />
        </g>
      </g>
    </svg>
  </div>

  <div class="wrap inner">
    <span class="status">
      <span class="pulse" aria-hidden="true"></span>
      Booking projects for July
    </span>

    <h1>
      I build websites that
      <span class="accent">PULL THEIR WEIGHT</span>
    </h1>

    <p class="lede">
      Independent web studio crafting fast, modern sites for ambitious brands.
      Less fluff, more pull — your site should win you customers, not babysit them.
    </p>

    <div class="ctas">
      <a class="btn btn-primary" href="#contact">Start a project</a>
      <a class="btn btn-ghost" href="#work">See selected work</a>
    </div>

    <p class="micro muted">
      Most clients come to me with a site that's costing them visitors. I fix that.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 11vw, 9rem) 0 clamp(4rem, 9vw, 7rem);
    isolation: isolate;
  }

  .orbit {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .grid-bg {
    position: absolute;
    inset: -20% -10% -10%;
    background-image:
      linear-gradient(to right, rgba(0, 230, 118, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 230, 118, 0.06) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 45%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 45%, #000 30%, transparent 75%);
  }

  /* Single SVG owns both the dashed ring and the planet, so they share
     one coordinate system. No DOM box-model surprises. */
  .orbit-svg {
    position: absolute;
    left: 50%;
    top: 62%;
    width: min(110vw, 1250px);
    aspect-ratio: 1250 / 294;
    transform: translate(-50%, -50%);
    overflow: visible;
  }

  .orbit-mover {
    offset-path: path("M 1250 147 a 625 147 0 1 1 -1250 0 a 625 147 0 1 1 1250 0");
    offset-rotate: 0deg;
    animation: orbit 16s linear infinite reverse;
    will-change: offset-distance;
  }

  /* Spin lives on a child so the orbit translate and the axial rotate
     don't fight over the parent's transform. */
  .planet-spin {
    animation: spin 5s linear infinite;
    transform-origin: 0 0;
    transform-box: view-box;
    will-change: transform;
  }

  @keyframes orbit { to { offset-distance: 100%; } }
  @keyframes spin  { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .orbit-mover, .planet-spin, .pulse { animation: none; }
  }

  .inner {
    position: relative;
    max-width: 980px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 1.75rem;
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0 rgba(0, 230, 118, 0.7);
    animation: pulse 1.8s ease-out infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(0, 230, 118, 0.5); }
    100% { box-shadow: 0 0 0 14px rgba(0, 230, 118, 0); }
  }

  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.5rem, 7vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    font-weight: 600;
  }
  .accent {
    display: inline;
    background: linear-gradient(180deg, var(--green-soft) 0%, var(--green) 70%, var(--green-deep) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lede {
    margin-top: 1.6rem;
    max-width: 56ch;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .micro {
    margin-top: 2rem;
    font-size: 0.88rem;
  }
</style>
