---
---
<section class="hero" id="top">
  <div class="orbit" aria-hidden="true">
    <div class="grid-bg"></div>
    <svg class="orbit-svg" viewBox="0 0 1250 294" preserveAspectRatio="xMidYMid meet">
      <defs>
        <radialGradient id="orbit-fill" cx="50%" cy="50%" r="55%">
          <stop offset="0%" stop-color="rgba(0,230,118,0.18)" />
          <stop offset="55%" stop-color="rgba(0,230,118,0.09)" />
          <stop offset="100%" stop-color="rgba(0,230,118,0.0)" />
        </radialGradient>
        <radialGradient id="moon-grad" cx="32%" cy="28%" r="70%">
          <stop offset="0%" stop-color="#d3ffe2" />
          <stop offset="25%" stop-color="#6cf2a7" />
          <stop offset="55%" stop-color="#00e676" />
          <stop offset="100%" stop-color="#007a36" />
        </radialGradient>
        <radialGradient id="moon-shade" cx="72%" cy="80%" r="65%">
          <stop offset="0%" stop-color="rgba(0,0,0,0.55)" />
          <stop offset="100%" stop-color="rgba(0,0,0,0)" />
        </radialGradient>
        <radialGradient id="fist-grad" cx="35%" cy="22%" r="85%">
          <stop offset="0%" stop-color="#1f4a30" />
          <stop offset="35%" stop-color="#0e2a1a" />
          <stop offset="75%" stop-color="#06180e" />
          <stop offset="100%" stop-color="#020806" />
        </radialGradient>
      </defs>

      <!-- Tinted fill inside the orbit + solid outer ring -->
      <ellipse cx="625" cy="147" rx="624" ry="146"
        fill="url(#orbit-fill)"
        stroke="rgba(0,230,118,0.36)" stroke-width="1.5" />
      <!-- Inner dashed ring, inset -->
      <ellipse cx="625" cy="147" rx="582" ry="124"
        fill="none" stroke="rgba(0,230,118,0.22)"
        stroke-dasharray="6 6" />

      <!-- Central fist, middle finger up — counter-rotated to stay upright -->
      <g class="fist" transform="translate(625 147) rotate(14)">
        <!-- soft drop shadow under fist -->
        <ellipse cx="0" cy="72" rx="66" ry="9" fill="rgba(0,0,0,0.4)" />

        <!-- MIDDLE FINGER — tall, clearly extended -->
        <rect x="-18" y="-138" width="36" height="115" rx="17" fill="url(#fist-grad)" />
        <!-- two joint creases up the finger -->
        <path d="M -13 -108 Q 0 -103 13 -108" stroke="rgba(0,0,0,0.28)" stroke-width="2" fill="none" stroke-linecap="round" />
        <path d="M -13 -72 Q 0 -67 13 -72" stroke="rgba(0,0,0,0.28)" stroke-width="2" fill="none" stroke-linecap="round" />
        <!-- knuckle (base of middle finger meeting hand) -->
        <path d="M -17 -28 Q 0 -22 17 -28" stroke="rgba(0,0,0,0.35)" stroke-width="2.5" fill="none" stroke-linecap="round" />
        <!-- fingernail highlight -->
        <ellipse cx="0" cy="-125" rx="11" ry="6.5" fill="rgba(180,255,210,0.22)" />

        <!-- curled-down fingers showing on either side of middle finger -->
        <!-- left (index) -->
        <rect x="-50" y="-38" width="26" height="24" rx="11" fill="url(#fist-grad)" />
        <path d="M -46 -32 Q -37 -34 -28 -32" stroke="rgba(0,0,0,0.3)" stroke-width="1.8" fill="none" stroke-linecap="round" />
        <!-- right (ring + pinky as one bump) -->
        <rect x="24" y="-38" width="26" height="24" rx="11" fill="url(#fist-grad)" />
        <path d="M 28 -32 Q 37 -34 46 -32" stroke="rgba(0,0,0,0.3)" stroke-width="1.8" fill="none" stroke-linecap="round" />

        <!-- fist body / palm -->
        <rect x="-54" y="-20" width="108" height="88" rx="24" fill="url(#fist-grad)" />

        <!-- knuckle dimples (front of folded fingers) -->
        <circle cx="-32" cy="-6" r="6.5" fill="rgba(0,0,0,0.2)" />
        <circle cx="-10" cy="-9" r="6.5" fill="rgba(0,0,0,0.2)" />
        <circle cx="10"  cy="-9" r="6.5" fill="rgba(0,0,0,0.2)" />
        <circle cx="32"  cy="-6" r="6.5" fill="rgba(0,0,0,0.2)" />

        <!-- thumb folded across the front -->
        <ellipse cx="-48" cy="22" rx="17" ry="32" fill="url(#fist-grad)"
          transform="rotate(-14 -48 22)" />
        <!-- thumbnail highlight -->
        <ellipse cx="-60" cy="2" rx="5" ry="9" fill="rgba(180,255,210,0.18)"
          transform="rotate(-14 -48 22)" />

        <!-- top highlight on knuckle line -->
        <ellipse cx="0" cy="-4" rx="40" ry="4" fill="rgba(180,255,210,0.10)" />
      </g>

      <!-- Two orbiting fists, one chasing the other -->
      <g class="orbit-mover orbit-fist-lead">
        <g class="mini-fist" transform="rotate(14)">
          <!-- soft drop shadow -->
          <ellipse cx="0" cy="22" rx="22" ry="3" fill="rgba(0,0,0,0.45)" />
          <!-- curled fingers nubs on either side -->
          <rect x="-22" y="-2" width="13" height="11" rx="5.5" fill="url(#fist-grad)" />
          <rect x="9" y="-2" width="13" height="11" rx="5.5" fill="url(#fist-grad)" />
          <!-- palm body -->
          <rect x="-22" y="6" width="44" height="20" rx="9" fill="url(#fist-grad)" />
          <!-- knuckle dimples -->
          <circle cx="-13" cy="3.5" r="2.4" fill="rgba(0,0,0,0.28)" />
          <circle cx="-4.5" cy="2" r="2.4" fill="rgba(0,0,0,0.28)" />
          <circle cx="4.5" cy="2" r="2.4" fill="rgba(0,0,0,0.28)" />
          <circle cx="13" cy="3.5" r="2.4" fill="rgba(0,0,0,0.28)" />
          <!-- thumb folded -->
          <ellipse cx="-19" cy="13" rx="6.5" ry="11.5" fill="url(#fist-grad)"
            transform="rotate(-14 -19 13)" />
          <ellipse cx="-23.5" cy="6" rx="2" ry="3.5" fill="rgba(180,255,210,0.18)"
            transform="rotate(-14 -19 13)" />
          <!-- animated middle finger -->
          <g class="finger">
            <rect x="-6.5" y="-44" width="13" height="42" rx="6" fill="url(#fist-grad)" />
            <path d="M -4.5 -32 Q 0 -29 4.5 -32" stroke="rgba(0,0,0,0.3)" stroke-width="1.2" fill="none" stroke-linecap="round" />
            <path d="M -4.5 -18 Q 0 -15 4.5 -18" stroke="rgba(0,0,0,0.3)" stroke-width="1.2" fill="none" stroke-linecap="round" />
            <ellipse cx="0" cy="-38" rx="3.8" ry="2.3" fill="rgba(180,255,210,0.25)" />
          </g>
        </g>
      </g>
      <g class="orbit-mover orbit-fist-trail">
        <g class="mini-fist" transform="rotate(14)">
          <ellipse cx="0" cy="22" rx="22" ry="3" fill="rgba(0,0,0,0.45)" />
          <rect x="-22" y="-2" width="13" height="11" rx="5.5" fill="url(#fist-grad)" />
          <rect x="9" y="-2" width="13" height="11" rx="5.5" fill="url(#fist-grad)" />
          <rect x="-22" y="6" width="44" height="20" rx="9" fill="url(#fist-grad)" />
          <circle cx="-13" cy="3.5" r="2.4" fill="rgba(0,0,0,0.28)" />
          <circle cx="-4.5" cy="2" r="2.4" fill="rgba(0,0,0,0.28)" />
          <circle cx="4.5" cy="2" r="2.4" fill="rgba(0,0,0,0.28)" />
          <circle cx="13" cy="3.5" r="2.4" fill="rgba(0,0,0,0.28)" />
          <ellipse cx="-19" cy="13" rx="6.5" ry="11.5" fill="url(#fist-grad)"
            transform="rotate(-14 -19 13)" />
          <ellipse cx="-23.5" cy="6" rx="2" ry="3.5" fill="rgba(180,255,210,0.18)"
            transform="rotate(-14 -19 13)" />
          <g class="finger">
            <rect x="-6.5" y="-44" width="13" height="42" rx="6" fill="url(#fist-grad)" />
            <path d="M -4.5 -32 Q 0 -29 4.5 -32" stroke="rgba(0,0,0,0.3)" stroke-width="1.2" fill="none" stroke-linecap="round" />
            <path d="M -4.5 -18 Q 0 -15 4.5 -18" stroke="rgba(0,0,0,0.3)" stroke-width="1.2" fill="none" stroke-linecap="round" />
            <ellipse cx="0" cy="-38" rx="3.8" ry="2.3" fill="rgba(180,255,210,0.25)" />
          </g>
        </g>
      </g>
    </svg>
  </div>

  <div class="wrap inner">
    <span class="status">
      <span class="pulse" aria-hidden="true"></span>
      Powered by Claude — sites in hours, not weeks
    </span>

    <h1>
      I build websites that
      <span class="accent">PULL THEIR WEIGHT</span>
    </h1>

    <p class="lede">
      Independent web studio crafting fast, modern sites for ambitious brands.
      Less fluff, more pull — your site should win you customers, not babysit them.
    </p>

    <div class="ctas">
      <a class="btn btn-primary" href="#contact">Start a project</a>
      <a class="btn btn-ghost" href="#work">See selected work</a>
    </div>

    <p class="micro muted">
      Most clients come to me with a site that's costing them visitors. I fix that.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 11vw, 9rem) 0 clamp(4rem, 9vw, 7rem);
    isolation: isolate;
  }

  .orbit {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .grid-bg {
    position: absolute;
    inset: -20% -10% -10%;
    background-image:
      linear-gradient(to right, rgba(0, 230, 118, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 230, 118, 0.06) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 45%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 45%, #000 30%, transparent 75%);
  }

  /* Single SVG owns both the dashed ring and the planet, so they share
     one coordinate system. No DOM box-model surprises. */
  .orbit-svg {
    position: absolute;
    left: 50%;
    top: 42%;
    width: min(110vw, 1250px);
    aspect-ratio: 1250 / 294;
    transform: translate(-50%, -50%) rotate(-14deg);
    overflow: visible;
  }

  .orbit-mover {
    offset-path: path("M 1250 147 a 625 147 0 1 1 -1250 0 a 625 147 0 1 1 1250 0");
    offset-rotate: 0deg;
    animation: orbit 18s linear infinite reverse;
    will-change: offset-distance;
  }
  /* Lead fist starts at 0, trail follows 12% behind on the same path */
  .orbit-fist-lead  { animation-delay: 0s; }
  .orbit-fist-trail { animation-delay: -2.16s; }

  /* Middle finger fold/extend — offset between the two fists for variety */
  .mini-fist .finger {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: fingerFold 2.6s cubic-bezier(0.5, 0, 0.3, 1) infinite;
    will-change: transform;
  }
  .orbit-fist-trail .finger { animation-delay: -1.3s; }

  @keyframes orbit { to { offset-distance: 100%; } }
  @keyframes fingerFold {
    0%, 14%   { transform: scaleY(0.06); }
    44%, 64%  { transform: scaleY(1); }
    90%, 100% { transform: scaleY(0.06); }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-mover, .mini-fist .finger, .pulse { animation: none; }
    .mini-fist .finger { transform: scaleY(1); }
  }

  .inner {
    position: relative;
    max-width: 980px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 1.75rem;
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0 rgba(0, 230, 118, 0.7);
    animation: pulse 1.8s ease-out infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(0, 230, 118, 0.5); }
    100% { box-shadow: 0 0 0 14px rgba(0, 230, 118, 0); }
  }

  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.5rem, 7vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    font-weight: 600;
  }
  .accent {
    display: inline;
    background: linear-gradient(180deg, var(--green-soft) 0%, var(--green) 70%, var(--green-deep) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lede {
    margin-top: 1.6rem;
    max-width: 56ch;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
    justify-content: center;
  }

  .micro {
    margin-top: 2rem;
    font-size: 0.88rem;
    text-align: center;
  }
</style>
